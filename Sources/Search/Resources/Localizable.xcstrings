    "settings.privacy.notifications.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A site asks on a card over its page, and only one you allow reaches your Mac's notifications. Private tabs are never asked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站点在页面上以卡片询问，只有你允许的才会进入 Mac 通知。无痕标签页不会被询问"
          }
        }
      }
    },
    "settings.privacy.notifications.title": {
      "extractionState": "manual",
      "localizations": {
