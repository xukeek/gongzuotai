    "settings.privacy.tracking.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As in Safari. Off, sites you rarely open keep their sign-ins, and trackers inside other sites can follow you across them again, as in Chrome. Private tabs keep it on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 Safari 相同。关闭后，少访问的站点会保留登录，其他站点内的跟踪器可再次跨站跟随，如同 Chrome。无痕标签页始终开启"
          }
        }
      }
    },
    "settings.privacy.tracking.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent cross-site tracking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止跨站点跟踪"
          }
        }
      }
    },
    "settings.privacy.tryAgain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "settings.tabs.bookmarksBar.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bookmarks in a row above the page, folders opening as menus. It folds away with the tabs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面上方一排书签，文件夹以菜单打开。与标签页一并收起"
          }
        }
      }
    },
