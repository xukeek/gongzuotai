    "dialog.space.delete.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its tabs close, and its cookies and sign-ins are erased from this Mac. History and bookmarks stay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其标签页将关闭，本机上的 Cookie 与登录状态会被清除。历史记录与书签保留。"
          }
        }
      }
    },
