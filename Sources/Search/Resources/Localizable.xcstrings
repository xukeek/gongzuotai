          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧边栏位置"
          }
        }
      }
    },
    "settings.tabs.reading.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab you're on fills with grey as you scroll down the page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前标签页随你向下滚动以灰色填充"
          }
        }
      }
    },
    "settings.tabs.reading.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show how far you've read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示阅读进度"
          }
        }
      }
    },
    "settings.tabs.sideHides.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page takes the whole window; push against its %@ edge for the tabs. ⌘S keeps them out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面占满窗口；推向%@边缘显示标签页。⌘S 可保持收起。"
          }
        }
      }
    },
    "settings.tabs.sideHides.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the sidebar until the pointer reaches the edge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针到边缘时才显示侧边栏"
          }
        }
      }
    },
    "settings.tabs.sidebar.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Down the %@ instead of across the top. Pull its edge to make it wider; double-click the edge to reset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿%@排列，而不是横跨顶部。拖边缘加宽；双击边缘复位。"
          }
        }
      }
    },
    "settings.tabs.sidebar.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs in a sidebar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧边栏标签页"
          }
        }
      }
    },
    "settings.tabs.siteSearch.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the start of a site's name, like red or yout, then Tab, and what you type next searches that site. Sites you visit that offer a search join the list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入站点名开头如 red 或 yout，然后按 Tab，之后输入的内容会在该站搜索。访问过且提供搜索的站点会加入列表。"
          }
        }
      }
    },
    "settings.tabs.siteSearch.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search a site from the address field"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从地址栏搜索站点"
          }
        }
      }
    },
    "settings.tabs.sleep.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After half an hour away they come back where you left them. Pinned tabs, sound, calls and anything typed stay awake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开半小时后会从离开处恢复。固定标签、有声音、通话或已输入内容的保持唤醒。"
          }
        }
      }
    },
    "settings.tabs.sleep.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep tabs you aren't using"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "休眠未使用的标签页"
          }
        }
      }
    },
    "settings.tabs.spaces.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate sets of tabs, signed in where the others are or starting afresh, switched with ⌃1–⌃9, two fingers sideways over the column, or the space's icon. Mission Control's own ⌃1–⌃9, if you turned them on, take those keys first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立的标签页集合，可沿用登录或重新开始；用 ⌃1–⌃9、在栏上双指横滑或空间图标切换。若已开启调度中心的 ⌃1–⌃9，那些快捷键优先。"
          }
        }
      }
    },
    "settings.tabs.spaces.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaces"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间"
          }
        }
      }
    },
    "settings.tabs.split.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show two tabs side by side. Drag a tab onto a page to pair them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "并排显示两个标签页。将标签页拖到页面上即可配对。"
