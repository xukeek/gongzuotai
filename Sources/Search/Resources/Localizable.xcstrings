    "dialog.tls.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its certificate isn't trusted by this Mac. Someone could be reading what you send. Continue only if you know why it looks like this."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 不信任其证书。可能有人在读取你发送的内容。仅在你了解原因时继续。"
          }
        }
      }
    },
