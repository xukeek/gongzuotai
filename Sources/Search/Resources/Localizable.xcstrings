    },
    "settings.tabs.position.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs down the %@ edge of the window"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
