    "settings.general.autoScroll.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the wheel on a page, then move the mouse up or down to scroll, as on Windows. Click again to stop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在页面上点按滚轮，然后上下移动鼠标滚动，如同 Windows。再点一次停止"
          }
        }
      }
    },
    "settings.general.autoScroll.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll with the middle button"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用中键滚动"
          }
        }
      }
    },
    "settings.general.autocorrect.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS's autocorrect inside pages — the one that capitalises for you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面内使用 macOS 自动更正——包括自动大写"
          }
        }
      }
    },
    "settings.general.autocorrect.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct spelling as you type"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键入时纠正拼写"
          }
        }
      }
    },
    "settings.general.bench.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local socket for testing. Its tabs open beside yours with a flask on them and never take over — see ./bench"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于测试的本地套接字。其标签页旁会有烧瓶标记，且不会抢占——见 ./bench"
          }
        }
      }
    },
    "settings.general.bench.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let a script drive Gongzuotai"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许脚本驱动 工作台"
          }
        }
      }
    },
    "settings.general.bringThings.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmarks, history, passwords and extensions from another browser on this Mac, or from a file it exported"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这台 Mac 上的其他浏览器，或从其导出的文件，导入书签、历史、密码和扩展"
          }
        }
      }
    },
    "settings.general.bringThings.pill": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring Things Over…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入…"
          }
        }
      }
    },
    "settings.general.bringThings.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring things over"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入内容"
          }
        }
      }
    },
    "settings.general.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "settings.general.commandBar.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A word like \"settings\" or \"new tab\", typed alone in the address field, goes there instead of searching for it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在地址栏单独输入如 \"settings\" 或 \"new tab\" 会执行命令，而不是搜索"
          }
        }
      }
    },
    "settings.general.commandBar.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address bar commands"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址栏命令"
          }
        }
      }
    },
    "settings.general.fastPages.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animations and scrolling in pages at up to 120 frames a second on a screen that can, instead of 60 as in Safari. Uses more battery. Open tabs follow when reloaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在支持的屏幕上，页面动画与滚动最高 120 帧，而非 Safari 的 60。更耗电。已打开的标签页需重新加载后生效"
          }
        }
      }
    },
    "settings.general.fastPages.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages at 120 Hz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面 120 Hz"
          }
        }
      }
    },
    "settings.general.floatFlicks.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two fingers on it send it to the corner or edge they point at, instead of pushing it along; a strong swipe at the side of the screen it is against tucks it in there, a sliver left to bring it back by. Dragging still puts it anywhere"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双指轻扫会送到所指角落或边缘，而不是拖着走；贴边用力一滑可收起，留一条边再唤回。拖移仍可放到任意位置"
          }
        }
      }
    },
    "settings.general.floatFlicks.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flick the floating video to a corner"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻甩浮窗视频到角落"
          }
        }
      }
    },
    "settings.general.floatsAway.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A video playing on the site you're on comes out into its floating window as another app comes to the front, and goes back into its tab when you return"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前站点正在播放的视频会在其他 App 到前台时浮出，返回时收回标签页"
          }
        }
      }
    },
    "settings.general.floatsAway.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Float the video when you switch apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换 App 时浮窗播放视频"
          }
        }
      }
    },
    "settings.general.floatsOnLeave.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A video playing on YouTube and the like comes out into its floating window when you go to another tab, and back when you return. ⇧⌘P still floats one by hand"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube 等站点正在播放的视频会在你切到其他标签页时浮出，返回时收回。⇧⌘P 仍可手动浮窗"
          }
        }
      }
    },
    "settings.general.floatsOnLeave.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Float the video when you switch tabs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换标签页时浮窗播放视频"
          }
        }
      }
    },
    "settings.general.holdsHistory.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe back or forward and keep your fingers down: the pages that way appear, and moving up or down picks one to go to"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向后或向前滑动并按住手指：会出现该方向的页面，上下移动即可选取"
          }
        }
      }
    },
    "settings.general.holdsHistory.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a swipe to pick from history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住滑动以从历史中选取"
          }
        }
      }
