    "settings.tabs.groups.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Named sections in the sidebar. Right-click a tab to start a group; click its heading to hide or show its tabs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧边栏中的命名分区。右键标签页可建组；点按组标题可折叠或展开。"
          }
        }
      }
    },
    "settings.tabs.groups.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab groups"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页分组"
          }
        }
      }
    },
    "settings.tabs.lazy.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A link opened behind the page, with ⌘-click or the middle button, or a batch of links from another app, waits until you go to its tab. ⇧⌘-click still takes you there at once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-点按或中键在后台打开的链接，或其他 App 批量打开的，等到你切到该标签页再加载。⇧⌘-点按仍会立刻前往。"
          }
        }
      }
    },
    "settings.tabs.lazy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load background tabs when you go to them"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转到后台标签页时再加载"
          }
        }
      }
    },
    "settings.tabs.navLeft.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beside the window's buttons, before the tabs"
          }
        },
        "zh-Hans": {
