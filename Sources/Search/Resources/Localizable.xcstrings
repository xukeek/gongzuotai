    "settings.tabs.fresh.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each time Gongzuotai opens, your pinned tabs are there and last time's other tabs aren't."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次打开 工作台 时保留固定标签页，不恢复上次其他标签页。"
          }
        }
